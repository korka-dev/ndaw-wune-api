# ────────────────────────────────────────────────────────────────────────────
# Copiez ce fichier en .env et remplissez vos valeurs.
# Ne commitez JAMAIS le fichier .env dans git.
# ────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=ARED-NdawWune
# "production" sur le VPS : désactive Swagger (/docs) et restreint le CORS
# à https://admin.ndawwune.cloud. "development" en local.
APP_ENV=production
# Générer avec : python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=

# Origines autorisées pour le CORS (séparées par virgule) — utilisé en développement
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Compte administrateur initial ─────────────────────────────────────────────
# Créé UNE fois par `make create-admin` (ou deploy_vps.sh au premier install),
# jamais au démarrage du conteneur. Un compte existant n'est jamais modifié.
# Le mot de passe est temporaire : changement imposé à la première connexion.
# Laisser ADMIN_PASSWORD vide pour ne créer aucun compte.
ADMIN_EMAIL=
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=

# Nombre de workers Gunicorn (uvicorn async) — règle : 2×vCPU+1
# 9 = calibré pour un VPS 4 vCPU/8 Go. Ajuster si le VPS change de taille.
GUNICORN_WORKERS=9

# Taille du pool de connexions SQLAlchemy PAR WORKER (async, non bloquant).
# Total de connexions DB possibles = (MAX_CONNECTIONS_POOL + MAX_OVERFLOW) × GUNICORN_WORKERS.
# Avec les valeurs ci-dessous : (15+5) × 9 = 180 — doit rester < max_connections
# Postgres (voir docker-compose.yml, actuellement 220) pour laisser de la marge
# aux connexions admin/migrations/psql.
MAX_CONNECTIONS_POOL=15
MAX_OVERFLOW=5

# Dimensionnement Postgres / Redis (lus par docker-compose.yml).
# deploy_vps.sh recalcule ces valeurs et celles ci-dessus selon le VPS
# (vCPU et RAM) quand il génère le .env.
POSTGRES_MAX_CONNECTIONS=220
POSTGRES_SHARED_BUFFERS=512MB
REDIS_MAXMEMORY=256mb

# Durée du cache de synchronisation offline (en secondes)
# 300 = 5 min : filet de sécurité si l'invalidation Redis échoue
SYNC_CACHE_TTL_SECONDS=300

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ared_ndawune
POSTGRES_USER=ared_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db        # "db" en Docker, "localhost" en développement local
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis        # "redis" en Docker, "localhost" en développement local
REDIS_PORT=6379
REDIS_DB=0
# Optionnel (Redis n'écoute que sur le réseau Docker interne et 127.0.0.1).
# S'il est renseigné, Redis l'exige et le backend le reçoit à part : il est
# encodé dans l'URL de connexion, tous caractères autorisés (APP-43).
REDIS_PASSWORD=

# ── URLs construites automatiquement ──────────────────────────────────────────
# Ces deux variables sont interpolées depuis les variables ci-dessus.
# En développement local, remplacez POSTGRES_HOST=localhost et REDIS_HOST=localhost.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── Compatibilité application mobile (APP-46) ────────────────────────────────
# Version minimale acceptée sur /api/v1/app/* (vide = aucune). Les APK qui
# n'envoient pas encore X-App-Version ne sont jamais bloqués.
MIN_APP_VERSION=

# Durées de conservation en jours (APP-07, APP-13, APP-14) — vide = aucune purge.
# Purge serveur : python -m scripts.purge_retention [--appliquer]
RETENTION_AUDIOS_JOURS=
RETENTION_AUDIT_JOURS=
# Transmise à l'application : saisies déjà envoyées supprimées du téléphone au-delà.
RETENTION_SAISIES_TELEPHONE_JOURS=

# ── Règles terrain (lot L7, retours tuteurs et superviseurs) ──
# immediat | superviseur
REMPLACEMENT_VALIDATION=immediat
PHOTO_RAPPORT_OBLIGATOIRE=true
# secondes avant la fin d'une activité (vide = pas de préalerte)
MINUTEUR_PREALERTE_SECONDES=
MINUTEUR_SON=true
PROPOSITION_GROUPE_ACTIVE=true
SUPPORT_CONTACT=
SYSTEMES_SUPPORTES=Android 8 ou plus récent
RAPPELS_MAX_PAR_JOUR=2
# Lot L8 : l'inspecteur voit les noms des élèves absents (false = seulement leur nombre)
INSPECTEUR_NOMS_ABSENTS=false
LATEST_APP_VERSION=

# ── Limitation de débit (APP-11) ─────────────────────────────────────────────
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_REFRESH=30/minute

# Clôture des séances oubliées (rapport V2, APP-21) : intervalle en secondes de
# la tâche de fond. Aucune durée n'est inférée. 0 = désactivée.
SEANCE_CLEANUP_INTERVAL_SECONDS=900
