# ==============================================================================
#  NDAW WUNE — Config Caddy pour l'API Backend (FastAPI)
#
#  Le conteneur Docker sert FastAPI sur 127.0.0.1:8000 (voir docker-compose.yml,
#  le port n'est plus publié que sur localhost, pas sur 0.0.0.0).
#  Caddy fait le SSL (automatique via Let's Encrypt) et le reverse proxy.
#
#  Installé automatiquement par deploy_vps.sh : copié dans
#  /etc/caddy/sites/ndawwune-api.caddy (le domaine peut être changé avec
#  API_DOMAIN=...), le Caddyfile principal faisant `import /etc/caddy/sites/*.caddy`.
#  Le dashboard admin installe de la même façon son propre fichier
#  (ndawwune-admin.caddy) — un seul Caddy sert les deux domaines.
#
#  Pense à créer l'enregistrement DNS (A/AAAA) pour api.ndawwune.cloud
#  pointant vers l'IP de ce VPS avant de recharger — sinon l'émission du
#  certificat Let's Encrypt échouera.
# ==============================================================================

api.ndawwune.cloud {
    # /metrics n'est JAMAIS public — Prometheus le scrape en interne via le
    # réseau Docker (backend:8000), pas via ce domaine public.
    @metrics path /metrics
    respond @metrics 404

    # Taille max pour les imports (CSV, XLSX) et l'upload de ressources pédagogiques
    request_body {
        max_size 50MB
    }

    reverse_proxy 127.0.0.1:8000 {
        header_up Host              {host}
        header_up X-Real-IP         {remote_host}
        header_up X-Forwarded-For   {remote_host}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            read_timeout  60s
            write_timeout 60s
        }
    }

    encode gzip

    header {
        X-Frame-Options        "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy        "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}
