# ────────────────────────────────────────────────────────────────────────────
# Copiez ce fichier en ".env" (exactement ce nom) dans backend/monitoring/.
# Ne commitez JAMAIS le fichier .env dans git.
# ────────────────────────────────────────────────────────────────────────────

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_PASSWORD=
# URL publique une fois Caddy configuré (voir Caddyfile.monitoring) — sinon
# laisser la valeur par défaut http://localhost:3001 pour un accès local/tunnel SSH.
GRAFANA_ROOT_URL=https://monitoring.ndawwune.cloud

# ── PostgreSQL — RECOPIER les mêmes valeurs que backend/.env ──────────────────
# (nécessaire ici : Docker Compose n'interpole les ${VARIABLES} du docker-compose.yml
# qu'à partir du .env situé dans CE dossier, pas celui du dossier parent)
POSTGRES_USER=ared_user
POSTGRES_PASSWORD=
POSTGRES_DB=ared_ndawune

# ── Redis — RECOPIER la même valeur que backend/.env ───────────────────────────
REDIS_PASSWORD=
